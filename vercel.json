{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.reworkstudio.net"
        }
      ],
      "destination": "https://reworkstudio.net/:path*",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/consult.html",
      "destination": "/lead",
      "permanent": true
    },
    {
      "source": "/work",
      "destination": "/portfolio",
      "permanent": true
    },
    {
      "source": "/ig",
      "destination": "/?utm_source=instagram&utm_medium=profile",
      "permanent": false
    },
    {
      "source": "/threads",
      "destination": "/?utm_source=threads&utm_medium=profile",
      "permanent": false
    },
    {
      "source": "/linkedin",
      "destination": "/?utm_source=linkedin&utm_medium=profile",
      "permanent": false
    },
    {
      "source": "/naver",
      "destination": "/?utm_source=naver_blog&utm_medium=post",
      "permanent": false
    },
    {
      "source": "/youtube",
      "destination": "/?utm_source=youtube&utm_medium=description",
      "permanent": false
    },
    {
      "source": "/kakao",
      "destination": "/?utm_source=kakao&utm_medium=channel",
      "permanent": false
    },
    {
      "source": "/pdf",
      "destination": "/?utm_source=proposal&utm_medium=pdf",
      "permanent": false
    }
  ]
}
