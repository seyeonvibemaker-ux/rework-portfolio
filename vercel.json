{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.reworkstudio.net"
        }
      ],
      "destination": "https://reworkstudio.net/:path*",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/consult.html",
      "destination": "/lead",
      "permanent": true
    },
    {
      "source": "/work",
      "destination": "/portfolio",
      "permanent": true
    }
  ]
}
